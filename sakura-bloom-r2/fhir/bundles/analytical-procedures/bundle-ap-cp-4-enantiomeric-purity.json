    },
    "status": "active",
    "subjectReference": {
     "reference": "SubstanceDefinition/cp-4"
    },
    "description": "Core quality information (2.3.3.AP) for Analytical Procedures (Enantiomeric purity SM1)[Purity][CP-4].",
    "action": [
     {
      "title": "Technique",
      "description": "High performance liquid chromatography"
     },
     {
      "title": "Column",
      "description": "column of length 250 mm, internal diameter 4.6 mm ((type :coated polysaccharide chiral stationary phase) , 5 µm or equivalent"
     },
     {
      "title": "System",
      "description": "isocratic with UV detection"
     },
     {
      "title": "Mobile phase",
      "description": "n-Hexane/Isopropanol/Acetonitril/Diethylamine (80/15/5/0.1)"
     },
     {
      "title": "Flow rate",
      "description": "1.4 ml/min"
     },
     {
      "title": "Injection volume",
      "description": "10 µl"
     },
     {
      "title": "Detection",
      "description": "UV 230 nm"
     },
     {
      "title": "Test solution",
      "description": "Approximately 0.7 mg/ml of sample to be examined in diluent (same as mobile phase)."
     },
     {
      "title": "Identification solution",
      "description": "Approximately 0.7 mg/ml of CP-4 enantiomeric identification standard in diluent."
     },
     {
      "title": "System Suitability Criteria",
      "description": "Resolution NLT 1.5"
     },
     {
      "title": "Calculation",
      "description": "The content of enantiomer is calculated according to following formula: Enantiomer (%) =(r1/rt)*100 ri =      Response of peak due to enantiomer in the test solution rt =     sum of the CP-4 and CP-4 enantiomer responses in the test solution Enantiomer (%) = Content of enantiomer in the substance, in %"
     }
    ]
