    "description": "Core quality information (2.3.3.AP) for Analytical Procedures (Related Substances IM2)[Purity][CP-7].",
    "action": [
     {
      "title": "Technique",
      "description": "High performance liquid chromatography"
     },
     {
      "title": "Column",
      "description": "Silica C18 3,5 µm 250x4.6 mm or equivalent"
     },
     {
      "title": "System",
      "description": "gradient with UV  detection"
     },
     {
      "title": "Mobile phase",
      "description": "Acetonitrile/phosphate buffer (40:60)"
     },
     {
      "title": "Flow rate",
      "description": "1.0 ml/min"
     },
     {
      "title": "Injection volume",
      "description": "10 µl"
     },
     {
      "title": "Detection",
      "description": "UV, 230 nm"
     },
     {
      "title": "Test solution",
      "description": "Approximately 1.0 mg/ml of sample to be examined in diluent. (Acentonitril:phosphate buffer (1:4))"
     },
     {
      "title": "Reference solution",
      "description": "Approximately 0.001 mg/ml of CP-7 standard in diluent."
     },
     {
      "title": "System Suitability Criteria",
      "description": "Resolution > 1.5  Reproducibility (n=6) < 10 %                                                                                           RSD of the six areas obtained for the peak should be less than 10%."
     },
     {
      "title": "Calculation",
      "description": "The specified and unspecified degradation products are calculated against CP-7 in the reference solution with the corresponding Response correction factor (RF). IWP =  integration value of the by-product or degradation product in the test solution IWR =  integration value of the by-product or degradation product in the reference solution PR =    initial concentration of the reference substance [mg/mL] PP =    initial concentration of the substance [mg/mL] C =     content of the reference substance, in % 50*      exemplary dilution factor"
     },
     {
      "title": "Table 1‑2 Gradient Program",
      "description": "Time [min] | % A | % B; 0 | 90 | 10; 7,5 | 30 | 70; 10 | 30 | 70; 12,5 | 10 | 90; 15 | 10 | 90; 17.5 | 90 | 10; 20 | 90 | 10"
     }
    ]
