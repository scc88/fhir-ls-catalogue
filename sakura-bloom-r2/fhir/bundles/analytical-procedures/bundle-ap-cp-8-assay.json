     },
     {
      "title": "System",
      "description": "isocratic with UV detection"
     },
     {
      "title": "Mobile phase",
      "description": "Acetonitrile/phosphate buffer (40:60)"
     },
     {
      "title": "Flow rate",
      "description": "1.0 ml/min"
     },
     {
      "title": "Injection volume",
      "description": "10 µl"
     },
     {
      "title": "Detection",
      "description": "UV, 230 nm"
     },
     {
      "title": "Test solution",
      "description": "Approximately 1.0 mg/ml of sample to be examined in diluent (acentonitrile:phosphate buffer(1:4))"
     },
     {
      "title": "Reference solution",
      "description": "Approximately 1.0 mg/mg of CP-8 standard in diluent."
     },
     {
      "title": "System Suitability Criteria",
      "description": "Theoretical plates > 3200 Reproducibility (n=5) < 0.73 %                                        RSD <1.0%"
     },
     {
      "title": "Calculation",
      "description": "The content of CP-8 is calculated according to the following formula: (Am*Cs/As*Cm)*V Am =   Peak area value of CP-8 in the test solution As =   Peak area value of CP-8 in the reference solution Cs =   Weight of CP-8 (mg) in the reference solution Cm =   Weight of CP-8 (mg) in the test solution V =     Assay of CP-8 standard, in % Report the result “as is”."
     }
    ]
