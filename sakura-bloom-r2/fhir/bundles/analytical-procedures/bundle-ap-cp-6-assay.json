     {
      "title": "Test solution",
      "description": "Approximately 0.1 mg/ml of sample to be examined in diluent (Acetonitrile: pH 5.0 Phosphate Buffer (1:4))."
     },
     {
      "title": "Reference solution",
      "description": "Approximately 0.1 mg/ml of CP-6 standard in diluent."
     },
     {
      "title": "System Suitability Criteria",
      "description": "Theoretical plates > 3200  Reproducibility (n=5) < 0.73 %                                                                                        RSD of  ≤ 1% for n≥ 5 is desirable."
     },
     {
      "title": "Calculation",
      "description": "The content of CP-6 is calculated according to the following formula: (Am*Cs/As*Cm)*V AM =   Peak area value of CP-6 in the test solution AS =    Peak area value of CP-6 in the reference solution CS =    Weight of CP-6 (mg) in the reference solution CM =   Weight of CP-6 (mg) in the test solution V =      Assay of CP-6 standard, in % Report the result “as is”."
     }
